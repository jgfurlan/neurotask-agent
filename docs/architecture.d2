direction: right

# Actors
Guest: Flutter App / Zoe Voice UI {
  shape: person
}

# Shipboard Edge Environment (Offline-First)
Edge: Shipboard Edge (ECS & Couchbase) {
  API: FastAPI Backend {
    /ocean/chat: "POST /chat"
    /ocean/guest/profile: "GET /profile"
  }

  Orchestrator: LangGraph Multi-Agent {
    Supervisor: Supervisor Node {
      shape: circle
    }
    
    Workers: {
      GuestService: Guest Service Worker
      Advisor: Anticipatory Advisor
      Verifier: Verifier Node (RLVR) {
        shape: diamond
      }
    }
  }
}

# Cloud Providers (Sync)
Cloud: Cloud Environment (Snowflake & AWS) {
  Snowflake: Snowflake Cortex AI {
    shape: cylinder
    Genomics: "Guest Genomics DB"
    Telemetry: "RLVR Metrics"
  }

  AWSBedrock: AWS Bedrock {
    shape: cloud
    ClaudeSonnet: "Claude 3.5 Sonnet"
    ClaudeHaiku: "Claude 3.5 Haiku"
  }
}

# Connections
Guest -> Edge.API: "REST / WebSocket"
Edge.API -> Edge.Orchestrator.Supervisor: "Invoke Graph"

Edge.Orchestrator.Supervisor -> Edge.Orchestrator.Workers.GuestService: "Delegate"
Edge.Orchestrator.Supervisor -> Edge.Orchestrator.Workers.Advisor: "Delegate"

Edge.Orchestrator.Workers.GuestService -> Edge.Orchestrator.Workers.Verifier: "Draft Action"
Edge.Orchestrator.Workers.Advisor -> Edge.Orchestrator.Workers.Verifier: "Draft Action"
Edge.Orchestrator.Workers.Verifier -> Edge.Orchestrator.Supervisor: "Reward / Audit Passed"

# Edge to Cloud Sync
Edge -> Cloud: "Couchbase Sync Gateway (Delta-Sync)"

Edge.Orchestrator.Workers.GuestService -> Cloud.Snowflake: "Query/Mutate (Sync)"
Edge.Orchestrator.Workers.Advisor -> Cloud.Snowflake: "Vector Search / RAG"

Edge.Orchestrator.Supervisor -> Cloud.AWSBedrock: "Reasoning"
Edge.Orchestrator.Workers.GuestService -> Cloud.AWSBedrock: "Execution"
Edge.Orchestrator.Workers.Advisor -> Cloud.AWSBedrock: "Generation"

direction: down

Request: {
  label: "ChatRequest"
  content: "guest_id: UUID\nmessage: String\nlocation: LocationContext"
}

State: {
  label: "AgentState"
  content: "guest_id: String\nmessages: List\ncontext: Map\nreward: Float"
}

Flow: {
  API: "FastAPI Endpoint"
  Init: "Initialize State"
  Load: "load_context_node"
  DB: "Snowflake.get_guest_profile"
  Profile: "GuestProfileResponse"
  Sup: "Supervisor Node"
  Worker: "Guest Service / Advisor Node"
  Verifier: "Verifier Node (RLVR)"

  API -> Init
  Init -> Load
  Load -> DB
  DB -> Profile
  Profile -> Load
  Load -> Sup
  Sup -> Worker: "Delegate Task"
  Worker -> Verifier: "Draft Output & Tool Calls"
  Verifier -> Sup: "Reward Signal & Audit"
  Sup -> API: "Return Final Response"
}
